{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "apphosting": {
    "backendId": "ronduel-web",
    "rootDir": "apps/web",
    "ignore": [
      "node_modules",
      "**/node_modules/**",
      ".next",
      "**/.next/**",
      ".git",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "playwright-report",
      "test-results",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "src",
        "tsconfig.json",
        "scripts-build.mjs"
      ],
      "predeploy": [
        "pnpm --filter @ronduel/shared build",
        "pnpm --filter @ronduel/functions bundle"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
