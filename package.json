{
  "name": "ronduel",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -n web,emulators -c cyan,yellow \"pnpm --filter @ronduel/web dev\" \"pnpm emulators\"",
    "dev:web": "pnpm --filter @ronduel/web dev",
    "emulators": "firebase emulators:start --project demo-ronduel",
    "build": "pnpm --filter @ronduel/shared build && pnpm --filter @ronduel/functions bundle && node scripts/build-hosting.mjs",
    "build:web": "pnpm --filter @ronduel/web build",
    "build:hosting": "node scripts/build-hosting.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-ronduel --only firestore \"vitest run apps/web/tests/town-rules.test.ts\"",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/check-i18n.mjs && node scripts/check-hardcoded-ro.mjs && node scripts/check-town-i18n.mjs",
    "seed": "node scripts/seed.mjs",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.22.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.51.1",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "firebase-tools": "^15.37.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.9"
  }
}
